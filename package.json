{
  "name": "pixelpaper",
  "private": true,
  "version": "2.0.0",
  "description": "An offline pixel art creator for wallpapers, created with love by Samuel.",
  "author": {
    "name": "Samuel H. Cus",
    "email": "hello@samhc.us"
  },
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "assets": "node scripts/build_gallery.mjs",
    "build": "npm run build:app && tsc -b",
    "build:app": "npm run assets && vite build --mode app",
    "build:site": "npm run assets && vite build --mode site",
    "desktop:dist": "npm run build:app && electron-builder --config electron-builder.yml",
    "start": "vite preview --host 127.0.0.1",
    "typecheck": "tsc -b",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "test:site": "playwright test --config=playwright.download.config.ts"
  },
  "dependencies": {},
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "@fontsource-variable/geist": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.53.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.7.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "shadcn": "^4.21.4",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0"
  },
  "desktopName": "Pixelpaper"
}

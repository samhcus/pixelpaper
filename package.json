{
  "name": "wallpapers",
  "private": true,
  "version": "1.0.1",
  "description": "A simple wallpaper app created by Samuel.",
  "author": {
    "name": "Samuel H. Cus",
    "email": "hello@samhc.us"
  },
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web \"node --env-file-if-exists=.env --watch server/index.mjs\" \"vite --host 127.0.0.1\"",
    "assets": "node scripts/build_gallery.mjs",
    "build": "npm run build:app && tsc -b",
    "build:app": "npm run assets && vite build --mode app",
    "build:site": "npm run assets && vite build --mode site",
    "desktop:dist": "npm run build:app && electron-builder --config electron-builder.yml",
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "typecheck": "tsc -b",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "test:site": "playwright test --config=playwright.download.config.ts"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "express": "^5.2.1",
    "lucide-react": "^1.53.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.7.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "shadcn": "^4.21.4",
    "sharp": "^0.35.5",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "desktopName": "Wallpapers"
}
